18. Burbuja
Para i <- 1 Hasta 4
    Para j <- 1 Hasta 4-i
        Si A[j] > A[j+1] Entonces
            temp <- A[j]
            A[j] <- A[j+1]
            A[j+1] <- temp
        FinSi
    FinPara
FinPara

19. Selección
Para i <- 1 Hasta 4
    min <- i
    Para j <- i+1 Hasta 5
        Si A[j] < A[min] Entonces
            min <- j
        FinSi
    FinPara
FinPara

20. Inserción
Para i <- 2 Hasta 5
    aux <- A[i]
    j <- i - 1

    Mientras j > 0 Y A[j] > aux
        A[j+1] <- A[j]
        j <- j - 1
    FinMientras

    A[j+1] <- aux
FinPara


CASO INTEGRADOR: “ANÁLISIS INTELIGENTE DE DATOS”

Un sistema debe:

Leer un arreglo de 10 números
Ordenarlos (burbuja)
Calcular:
Suma (recursiva)
Promedio
Llenar una matriz 3x3 con los primeros datos
Mostrar la matriz
Dibujar una figura (barco o flor)
Calcular el factorial del número mayor (recursión)

Proceso SistemaCompleto

    Dimension A[10]
    Dimension M[3,3]
    Definir i, j, temp, suma, mayor, prom Como Entero

    // 1. Leer arreglo
    Para i <- 1 Hasta 10
        Escribir "Ingrese número ", i
        Leer A[i]
    FinPara

    // 2. Ordenamiento burbuja
    Para i <- 1 Hasta 9
        Para j <- 1 Hasta 9-i
            Si A[j] > A[j+1] Entonces
                temp <- A[j]
                A[j] <- A[j+1]
                A[j+1] <- temp
            FinSi
        FinPara
    FinPara

    Escribir "Arreglo ordenado:"
    Para i <- 1 Hasta 10
        Escribir A[i]
    FinPara

    // 3. Suma recursiva
    suma <- sumaRec(A, 10)
    prom <- suma / 10

    Escribir "Suma: ", suma
    Escribir "Promedio: ", prom

    // 4. Llenar matriz con primeros 9 datos
    k <- 1
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            M[i,j] <- A[k]
            k <- k + 1
        FinPara
    FinPara

    // 5. Mostrar matriz
    Escribir "Matriz:"
    Para i <- 1 Hasta 3
        Para j <- 1 Hasta 3
            Escribir Sin Saltar M[i,j], " "
        FinPara
        Escribir ""
    FinPara

    // 6. Dibujar barco
    Escribir "Figura:"
    Escribir "   |   "
    Escribir "  /|\  "
    Escribir " /_|_\ "
    Escribir "   |   "
    Escribir "~~~~~~~"

    // 7. Factorial del mayor
    mayor <- A[10]
    Escribir "Mayor: ", mayor
    Escribir "Factorial: ", factorial(mayor)

FinProceso


